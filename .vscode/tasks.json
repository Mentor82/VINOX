{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ovchat: build debug",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.ps1",
      "args": [
        "-Configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}